// Nevada Heir Finder — database schema.
//
// Conventions
// - Money is stored as integer cents (`...Cents Int`) and fees as basis points
//   (`feeBps`: 1000 = 10.00%). No floating-point money anywhere.
// - Legal dates (delivered to state, presumed abandoned, death, eligibility)
//   are calendar dates (`@db.Date`) and are always handled as UTC dates.
// - Fields ending in `Enc` hold AES-256-GCM ciphertext produced by
//   lib/crypto/pii.ts. Fields ending in `Hash` hold HMAC-SHA256 blind indexes.
// - The auth models (User, Session, Account, Verification, TwoFactor,
//   RateLimit) follow Better Auth 1.7's schema. Keep them in sync by hand
//   if Better Auth is upgraded (see README "Upgrading Better Auth").

generator client {
  provider        = "prisma-client"
  output          = "../lib/generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────────── Auth (Better Auth) ─────────────────────────────

enum Role {
  OWNER
  RESEARCHER
  VIEWER
}

model User {
  id               String      @id
  name             String
  email            String      @unique
  emailVerified    Boolean     @default(false)
  image            String?
  role             Role        @default(VIEWER)
  twoFactorEnabled Boolean?    @default(false)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  sessions         Session[]
  accounts         Account[]
  twoFactors       TwoFactor[]

  assignedCases Case[]     @relation("CaseAssignee")
  approvals     Approval[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

/// TOTP codes already used to sign in or enrol, so a code can't be replayed
/// within its validity window (ASVS 2.8.4). Rows are pruned after 5 minutes.
model UsedTotpCode {
  userId    String
  codeHash  String
  createdAt DateTime @default(now())

  @@id([userId, codeHash])
  @@index([createdAt])
  @@map("used_totp_codes")
}

model TwoFactor {
  id                      String    @id
  secret                  String
  backupCodes             String
  userId                  String
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  verified                Boolean?  @default(true)
  failedVerificationCount Int?      @default(0)
  lockedUntil             DateTime?

  @@index([secret])
  @@index([userId])
  @@map("two_factor")
}

model RateLimit {
  id          String @id
  key         String @unique
  count       Int
  lastRequest BigInt

  @@map("rate_limit")
}

// ───────────────────────────── Domain enums ─────────────────────────────

enum CaseStage {
  IMPORTED
  SCREENED
  OWNER_VERIFIED_DECEASED
  HEIRS_RESEARCHING
  HEIRS_IDENTIFIED
  WAITING_PERIOD
  READY_FOR_OUTREACH
  CONTACTED
  RESPONDED
  AGREEMENT_SENT
  AGREEMENT_SIGNED
  CLAIM_PACKET_PREPARED
  CLAIM_FILED
  CLAIM_APPROVED
  CLAIM_DENIED
  MORE_INFO_REQUESTED
  PAID_TO_HEIR
  FEE_INVOICED
  FEE_COLLECTED
  CLOSED_WON
  CLOSED_NO_HEIR
  CLOSED_DECLINED
  CLOSED_SELF_CLAIMED
  CLOSED_INELIGIBLE
}

enum PropertyCategory {
  LIFE_INSURANCE
  ANNUITY
  ESTATE
  OTHER
  UNKNOWN
}

enum EvidenceSourceType {
  OBITUARY
  DEATH_RECORD_INDEX
  PROBATE_FILING
  PUBLIC_RECORD
  PEOPLE_SEARCH_VENDOR
  USER_UPLOADED_DOCUMENT
  MANUAL_NOTE
}

enum Relationship {
  NAMED_BENEFICIARY
  SPOUSE
  CHILD
  GRANDCHILD
  PARENT
  SIBLING
  NIECE_NEPHEW
  GRANDPARENT
  AUNT_UNCLE
  COUSIN
  OTHER
  UNKNOWN
}

enum PersonStatus {
  CANDIDATE
  CONFIRMED
  REJECTED
}

enum CommunicationChannel {
  MAIL
  EMAIL
  INBOUND_PHONE_NOTE
  /// Inbound only: a message an heir sent through the portal.
  PORTAL_MESSAGE
}

enum CommunicationDirection {
  OUTBOUND
  INBOUND
}

enum CommunicationStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  QUEUED
  SENT
  DELIVERED
  RETURNED
  FAILED
  CANCELLED
  RECEIVED
}

enum AgreementStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  SENT
  SIGNED
  DECLINED
  CANCELLED
  VOIDED
}

enum ClaimPacketStatus {
  IN_PROGRESS
  READY_FOR_REVIEW
  APPROVED
  FILED
  APPROVED_BY_STATE
  DENIED_BY_STATE
  MORE_INFO_REQUESTED
}

enum InvoiceStatus {
  DRAFT
  OPEN
  PAID
  VOID
  UNCOLLECTIBLE
}

enum RuleType {
  WAITING_PERIOD
  FEE_CAP
  DISCLOSURE_TEXT
  AGREEMENT_REQUIREMENTS
  CLAIM_REQUIREMENTS
  INTESTATE_SUCCESSION
}

enum NotificationKind {
  CASE_UNLOCKED
  UNLOCK_BLOCKED
  IMPORT_FINISHED
  SYSTEM
  APPROVAL_NEEDED
  FOLLOW_UP_READY
  SEND_FAILED
  MAIL_RETURNED
  OPTED_OUT
  REPLY_RECEIVED
  AGREEMENT_SIGNED
  AGREEMENT_DECLINED
  DOCUMENT_UPLOADED
  PORTAL_ACTIVITY
  CLAIM_UPDATE
  INVOICE_PAID
}

enum ApprovalSubjectType {
  COMMUNICATION
  AGREEMENT
  CLAIM_PACKET
  INVOICE
}

enum ApprovalDecision {
  APPROVED
  REJECTED
}

enum ActorType {
  USER
  SYSTEM
  AI
  HEIR
}

enum AiRunStatus {
  SUCCEEDED
  INVALID_OUTPUT
  FAILED
}

enum ImportStatus {
  UPLOADED
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
}

enum DatePrecision {
  DAY
  MONTH
  YEAR
}

enum MatchStatus {
  PENDING
  MERGED
  REJECTED
}

enum AiAcceptance {
  PENDING
  ACCEPTED
  REJECTED
  NOT_APPLICABLE
}

// ───────────────────────────── Domain models ─────────────────────────────

model ImportBatch {
  id              String                @id @default(cuid())
  stateCode       String                @default("NV")
  fileName        String
  source          String // e.g. "NV Treasurer public-records request 2026-11"
  status          ImportStatus          @default(UPLOADED)
  fileType        String // "csv" | "xlsx"
  fileSha256      String
  /// Raw upload; cleared once processing finishes (the parsed rows live in properties).
  fileData        Bytes?
  headers         String[]              @default([])
  previewRows     Json                  @default("[]")
  columnMapping   Json?
  columnMappingId String?
  savedMapping    ColumnMapping?        @relation(fields: [columnMappingId], references: [id])
  rowCount        Int                   @default(0)
  insertedCount   Int                   @default(0)
  duplicateCount  Int                   @default(0)
  errorCount      Int                   @default(0)
  errors          Json                  @default("[]")
  newOwnerCount   Int                   @default(0)
  groupedCount    Int                   @default(0)
  reviewCount     Int                   @default(0)
  flaggedCount    Int                   @default(0)
  newCaseCount    Int                   @default(0)
  failureMessage  String?
  createdById     String?
  createdAt       DateTime              @default(now())
  startedAt       DateTime?
  completedAt     DateTime?
  properties      Property[]
  matchCandidates OwnerMatchCandidate[]

  @@index([fileSha256])
  @@map("import_batches")
}

/// A saved header → field mapping, reused for later files with the same layout.
model ColumnMapping {
  id          String        @id @default(cuid())
  name        String        @unique
  stateCode   String        @default("NV")
  /// { [propertyField]: "Source Header" }
  mapping     Json
  createdById String?
  createdAt   DateTime      @default(now())
  lastUsedAt  DateTime?
  batches     ImportBatch[]

  @@map("column_mappings")
}

/// Uncertain owner merge awaiting a human decision (never auto-merged).
model OwnerMatchCandidate {
  id              String       @id @default(cuid())
  /// The provisional owner created by the import.
  newOwnerId      String
  newOwner        Owner        @relation("MatchNew", fields: [newOwnerId], references: [id], onDelete: Cascade)
  /// The existing owner it may be the same person as.
  existingOwnerId String
  existingOwner   Owner        @relation("MatchExisting", fields: [existingOwnerId], references: [id], onDelete: Cascade)
  score           Float
  reasons         Json
  status          MatchStatus  @default(PENDING)
  importBatchId   String?
  importBatch     ImportBatch? @relation(fields: [importBatchId], references: [id])
  decidedById     String?
  decidedAt       DateTime?
  createdAt       DateTime     @default(now())

  @@unique([newOwnerId, existingOwnerId])
  @@index([status])
  @@map("owner_match_candidates")
}

model Property {
  id                     String           @id @default(cuid())
  stateCode              String           @default("NV")
  statePropertyId        String
  ownerNameRaw           String
  ownerNameNormalized    String?
  ownerAddressRaw        String?
  ownerAddressNormalized Json?
  holderName             String?
  propertyTypeCode       String?
  category               PropertyCategory @default(UNKNOWN)
  /// Nullable: the state does not always disclose the amount.
  reportedAmountCents    Int?
  datePresumedAbandoned  DateTime?        @db.Date
  /// NRS 120A.740 void period runs until 24 months after this date.
  dateDeliveredToState   DateTime?        @db.Date
  /// YEAR/MONTH = source only gave a year or month; the stored date is the
  /// LAST day of that period (the conservative choice for the void period and fee tier).
  dateDeliveredPrecision DatePrecision?
  /// Parsed name parts + markers from lib/normalize/name.ts.
  ownerNameParsed        Json?
  /// Name flags (ESTATE, DECEASED, CARE_OF, TRUST, JOINT, BUSINESS, UNKNOWN,
  /// ORDER_ASSUMED) plus record flags (AMOUNT_MINIMUM, DATE_APPROXIMATE, NO_ADDRESS, OUT_OF_STATE).
  flags                  String[]         @default([])
  /// True when the source gave a range or "over $X": reportedAmountCents is the lower bound.
  amountIsMinimum        Boolean          @default(false)
  sourceRowNumber        Int?
  hasDeceasedMarker      Boolean          @default(false)
  holderIsLifeInsurer    Boolean          @default(false)
  rawRecord              Json
  importBatchId          String?
  importBatch            ImportBatch?     @relation(fields: [importBatchId], references: [id])
  ownerId                String?
  owner                  Owner?           @relation(fields: [ownerId], references: [id])
  caseId                 String?
  case                   Case?            @relation(fields: [caseId], references: [id])
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt

  @@unique([stateCode, statePropertyId])
  @@index([ownerId])
  @@index([caseId])
  @@index([category])
  @@map("properties")
}

model Owner {
  id                    String                @id @default(cuid())
  stateCode             String                @default("NV")
  fullName              String
  normalizedName        String
  aliases               String[]              @default([])
  dateOfBirth           DateTime?             @db.Date
  dateOfDeath           DateTime?             @db.Date
  deathVerified         Boolean               @default(false)
  deathVerificationNote String?
  lastKnownAddresses    Json                  @default("[]")
  properties            Property[]
  cases                 Case[]
  matchesAsNew          OwnerMatchCandidate[] @relation("MatchNew")
  matchesAsExisting     OwnerMatchCandidate[] @relation("MatchExisting")
  /// Blocking keys for fuzzy matching (surname phonetic code, etc.).
  matchKeys             String[]              @default([])
  /// Set when a reviewer merged this (provisional) owner into another one.
  mergedIntoId          String?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  @@index([normalizedName])
  @@index([matchKeys], type: Gin)
  @@map("owners")
}

model Case {
  id                   String          @id @default(cuid())
  /// Human-friendly reference, shown as e.g. NV-000042.
  caseNumber           Int             @unique @default(autoincrement())
  stateCode            String          @default("NV")
  ownerId              String
  owner                Owner           @relation(fields: [ownerId], references: [id])
  stage                CaseStage       @default(IMPORTED)
  stageChangedAt       DateTime        @default(now())
  priorityScore        Int?
  priorityExplanation  String?
  /// [{ label, points }] — every factor behind priorityScore.
  priorityFactors      Json?
  /// estimated amount × fee rate × probability of success (cents); null if amount unknown.
  expectedValueCents   Int?
  successProbability   Float?
  scoredAt             DateTime?
  /// Accepted AI tracing-difficulty estimate: { difficulty 1-5, rationale, aiRunId, acceptedAt }.
  tracingAssessment    Json?
  assignedUserId       String?
  assignedUser         User?           @relation("CaseAssignee", fields: [assignedUserId], references: [id])
  estimatedValueCents  Int?
  /// Computed by lib/rules (latest eligible date across the case's properties).
  eligibleContractDate DateTime?       @db.Date
  notes                String?
  closedAt             DateTime?
  properties           Property[]
  persons              Person[]
  evidence             Evidence[]
  communications       Communication[]
  agreements           Agreement[]
  claimPackets         ClaimPacket[]
  heirDocuments        HeirDocument[]
  storedFiles          StoredFile[]
  portalAccesses       PortalAccess[]
  invoices             Invoice[]
  aiRuns               AiRun[]
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  @@index([stage])
  @@index([stage, priorityScore])
  @@index([eligibleContractDate])
  @@index([ownerId])
  @@map("cases")
}

model Person {
  id                     String          @id @default(cuid())
  caseId                 String
  case                   Case            @relation(fields: [caseId], references: [id], onDelete: Cascade)
  fullName               String
  normalizedName         String
  relationship           Relationship    @default(UNKNOWN)
  /// 0.0 – 1.0
  relationshipConfidence Float           @default(0)
  status                 PersonStatus    @default(CANDIDATE)
  isPredeceased          Boolean         @default(false)
  /// For descendants through a predeceased person (e.g. grandchild via child).
  parentPersonId         String?
  parentPerson           Person?         @relation("PersonLineage", fields: [parentPersonId], references: [id])
  children               Person[]        @relation("PersonLineage")
  dateOfBirth            DateTime?       @db.Date
  dateOfDeath            DateTime?       @db.Date
  emailEnc               String?
  phoneEnc               String?
  mailingAddressEnc      String?
  emailHash              String?
  sourceEvidenceIds      String[]        @default([])
  doNotContact           Boolean         @default(false)
  piiPurgedAt            DateTime?
  notes                  String?
  communications         Communication[]
  evidence               Evidence[]
  agreements             Agreement[]
  heirDocuments          HeirDocument[]
  portalAccesses         PortalAccess[]
  claimPackets           ClaimPacket[]
  invoices               Invoice[]
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt

  @@index([caseId])
  @@index([emailHash])
  @@map("persons")
}

model Evidence {
  id             String             @id @default(cuid())
  caseId         String
  case           Case               @relation(fields: [caseId], references: [id], onDelete: Cascade)
  personId       String?
  person         Person?            @relation(fields: [personId], references: [id])
  sourceType     EvidenceSourceType
  title          String?
  url            String?
  /// Object-storage key for uploaded files (encrypted at rest).
  fileKey        String?
  extractedFacts Json?
  /// Text pasted by the operator (e.g. an obituary). Public-record text only.
  rawText        String?
  /// True when this evidence supports the owner's death.
  supportsDeath  Boolean            @default(false)
  retrievedAt    DateTime           @default(now())
  addedByUserId  String?
  addedByAiRunId String?
  createdAt      DateTime           @default(now())

  @@index([caseId])
  @@map("evidence")
}

model Approval {
  id              String              @id @default(cuid())
  subjectType     ApprovalSubjectType
  subjectId       String
  decision        ApprovalDecision
  /// SHA-256 of the exact content approved. Sending verifies this matches.
  contentHash     String
  contentSnapshot String
  checklist       Json                @default("{}")
  reason          String?
  approvedById    String
  approvedBy      User                @relation(fields: [approvedById], references: [id])
  createdAt       DateTime            @default(now())

  @@index([subjectType, subjectId])
  @@map("approvals")
}

model Communication {
  id                   String                 @id @default(cuid())
  caseId               String
  case                 Case                   @relation(fields: [caseId], references: [id], onDelete: Cascade)
  personId             String?
  person               Person?                @relation(fields: [personId], references: [id])
  channel              CommunicationChannel
  direction            CommunicationDirection
  status               CommunicationStatus    @default(DRAFT)
  templateId           String?
  templateVersion      String?
  sequenceStep         Int?
  subject              String?
  renderedContent      String?
  /// Plain-text version (emails); renderedContent holds the HTML that is sent.
  textContent          String?
  /// Encrypted JSON snapshot of who it was sent to (name + address or email).
  recipientEnc         String?
  /// AI-drafted (then human-editable) personal paragraph.
  personalNote         String?
  personalizationRunId String?
  /// Compliance checklist and tone check computed for this exact content.
  checklist            Json?
  toneCheck            Json?
  /// Random token for the one-click unsubscribe link (emails).
  optOutToken          String?                @unique
  provider             String?
  /// Provider/webhook events: [{ at, type, detail }]
  events               Json                   @default("[]")
  cancelledReason      String?
  contentHash          String?
  approvalId           String?
  providerMessageId    String?
  deliveryStatus       String?
  scheduledFor         DateTime?
  sentAt               DateTime?
  createdById          String?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  @@index([caseId])
  @@index([status, scheduledFor])
  @@map("communications")
}

model Agreement {
  id                          String          @id @default(cuid())
  caseId                      String
  case                        Case            @relation(fields: [caseId], references: [id], onDelete: Cascade)
  /// The heir who signs (one agreement per heir).
  personId                    String?
  person                      Person?         @relation(fields: [personId], references: [id])
  /// [{ personId, name, email? }]
  signers                     Json
  feeBps                      Int
  /// The legal cap that applied when the agreement was generated.
  feeCapBps                   Int?
  propertyValueBeforeFeeCents Int
  propertyValueAfterFeeCents  Int
  /// Snapshot of the JurisdictionRule ids + versions used for validation.
  rulesApplied                Json
  templateVersion             String
  isAttorneyApprovedTemplate  Boolean         @default(false)
  /// StoredFile id of the generated (unsigned) PDF — what is approved and sent.
  pdfFileKey                  String?
  /// StoredFile id of the signed PDF (from the e-sign provider, or a scan of a paper signature).
  signedFileKey               String?
  /// Plain text of the agreement (approval snapshot and checks).
  textContent                 String?
  /// SHA-256 over the PDF bytes + signer; the approval must hold the same hash.
  contentHash                 String?
  approvalId                  String?
  /// "ESIGN" or "PAPER"
  signatureMethod             String?
  esignProvider               String?
  esignEnvelopeId             String?
  /// Validation results at generation and on each check.
  checklist                   Json?
  /// Provider/webhook events: [{ at, type, detail, eventId? }]
  events                      Json            @default("[]")
  status                      AgreementStatus @default(DRAFT)
  statusReason                String?
  sentAt                      DateTime?
  signedAt                    DateTime?
  createdById                 String?
  createdAt                   DateTime        @default(now())
  updatedAt                   DateTime        @updatedAt

  @@index([caseId])
  @@index([esignEnvelopeId])
  @@map("agreements")
}

/// Encrypted file content (AES-256-GCM, per-file IV). Files never leave the
/// database unencrypted except through an authorized, expiring download.
model StoredFile {
  id          String    @id @default(cuid())
  caseId      String?
  case        Case?     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  /// AGREEMENT_PDF | AGREEMENT_SIGNED | HEIR_UPLOAD | PAPER_SIGNATURE
  kind        String
  fileName    String
  contentType String
  sizeBytes   Int
  /// SHA-256 of the plaintext.
  sha256      String
  /// "v1" + IV + auth tag + ciphertext.
  data        Bytes
  /// USER:<id>, HEIR:<personId> or SYSTEM:<name>
  uploadedBy  String
  purgedAt    DateTime?
  createdAt   DateTime  @default(now())

  @@index([caseId])
  @@map("stored_files")
}

enum HeirDocumentStatus {
  RECEIVED
  ACCEPTED
  NEEDS_REPLACEMENT
}

/// A document an heir uploaded through the portal for a claim checklist item.
model HeirDocument {
  id           String             @id @default(cuid())
  caseId       String
  case         Case               @relation(fields: [caseId], references: [id], onDelete: Cascade)
  personId     String
  person       Person             @relation(fields: [personId], references: [id])
  /// Key from the CLAIM_REQUIREMENTS checklist (e.g. "death_certificate") or "other".
  checklistKey String
  fileId       String             @unique
  status       HeirDocumentStatus @default(RECEIVED)
  /// Shown to the heir when a replacement is needed.
  reviewNote   String?
  reviewedById String?
  reviewedAt   DateTime?
  createdAt    DateTime           @default(now())

  @@index([caseId])
  @@index([personId])
  @@map("heir_documents")
}

/// The unique portal link printed in letters. Only a hash of the token is
/// used for lookup; the encrypted token lets letters be re-rendered.
model PortalAccess {
  id          String          @id @default(cuid())
  caseId      String
  case        Case            @relation(fields: [caseId], references: [id], onDelete: Cascade)
  personId    String
  person      Person          @relation(fields: [personId], references: [id])
  tokenHash   String          @unique
  tokenEnc    String
  expiresAt   DateTime
  revokedAt   DateTime?
  lastUsedAt  DateTime?
  createdById String?
  createdAt   DateTime        @default(now())
  sessions    PortalSession[]

  @@index([personId])
  @@map("portal_access")
}

model PortalSession {
  id             String       @id @default(cuid())
  sessionHash    String       @unique
  portalAccessId String
  portalAccess   PortalAccess @relation(fields: [portalAccessId], references: [id], onDelete: Cascade)
  expiresAt      DateTime
  lastSeenAt     DateTime     @default(now())
  createdAt      DateTime     @default(now())

  @@map("portal_sessions")
}

/// Fixed-window request counters for public endpoints (portal, opt-out).
model RequestLimit {
  key         String   @id
  windowStart DateTime
  count       Int

  @@map("request_limits")
}

model ClaimPacket {
  id               String            @id @default(cuid())
  caseId           String
  case             Case              @relation(fields: [caseId], references: [id], onDelete: Cascade)
  /// The heir who files (the claimant).
  personId         String?
  person           Person?           @relation(fields: [personId], references: [id])
  /// Facts that decide which documents apply: { estatePath, hasWill, spouseClaimant, multipleHeirs }
  facts            Json              @default("{}")
  /// Per-item operator decisions: [{ key, status: "NOT_APPLICABLE" | "WAIVED", reason }]
  checklist        Json              @default("[]")
  status           ClaimPacketStatus @default(IN_PROGRESS)
  /// StoredFile id of the assembled PDF (cover letter + documents, in order).
  assembledPdfKey  String?
  /// [{ key, label, fileId, sha256, pages }] — exactly what went into the PDF.
  assembledFrom    Json?
  coverLetterText  String?
  /// SHA-256 over the assembled PDF + claimant; the approval must hold the same hash.
  contentHash      String?
  approvalId       String?
  filedAt          DateTime?
  filedMethod      String?
  stateClaimNumber String?
  outcome          String?
  outcomeAt        DateTime?
  outcomeNote      String?
  events           Json              @default("[]")
  createdById      String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([caseId])
  @@map("claim_packets")
}

model Invoice {
  id                    String        @id @default(cuid())
  caseId                String
  case                  Case          @relation(fields: [caseId], references: [id], onDelete: Cascade)
  /// The signed agreement this fee comes from (one invoice per signed agreement).
  agreementId           String?
  personId              String?
  person                Person?       @relation(fields: [personId], references: [id])
  /// What the State actually paid this heir (recorded from the heir's or the State's confirmation).
  amountPaidToHeirCents Int?
  paidToHeirAt          DateTime?     @db.Date
  paymentEvidence       String?
  feeBps                Int?
  amountCents           Int
  currency              String        @default("usd")
  status                InvoiceStatus @default(DRAFT)
  /// SHA-256 over recipient + amount + description; the approval must hold the same hash.
  contentHash           String?
  approvalId            String?
  description           String?
  provider              String?
  stripeCustomerId      String?
  stripeInvoiceId       String?
  paymentLinkUrl        String?
  dueDate               DateTime?     @db.Date
  issuedAt              DateTime?
  paidAt                DateTime?
  /// [{ day, at }]
  remindersSent         Json          @default("[]")
  events                Json          @default("[]")
  statusReason          String?
  createdById           String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  @@index([caseId])
  @@index([stripeInvoiceId])
  /// One live invoice per agreement; a voided one can be replaced (e.g. a mistyped amount).
  @@unique([agreementId], map: "invoices_agreementId_live_key", where: raw("status <> 'VOID'"))
  @@map("invoices")
}

model JurisdictionRule {
  id             String    @id @default(cuid())
  stateCode      String
  ruleType       RuleType
  version        Int       @default(1)
  /// Shape depends on ruleType; validated by Zod schemas in lib/rules/schemas.ts.
  params         Json
  effectiveFrom  DateTime  @db.Date
  effectiveTo    DateTime? @db.Date
  enabled        Boolean   @default(true)
  sourceCitation String
  sourceUrl      String?
  /// Null until the founder (or counsel) confirms against the official text.
  lastVerifiedAt DateTime?
  verifiedBy     String?
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([stateCode, ruleType, version])
  @@index([stateCode, ruleType, effectiveFrom])
  @@map("jurisdiction_rules")
}

/// Append-only. UPDATE/DELETE/TRUNCATE are rejected by a database trigger
/// (see prisma/migrations/*_audit_log_append_only).
model AuditLog {
  id         BigInt    @id @default(autoincrement())
  actorType  ActorType
  actorId    String?
  action     String
  entityType String
  entityId   String
  before     Json?
  after      Json?
  reason     String?
  ipAddress  String?
  createdAt  DateTime  @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

model AiRun {
  id            String       @id @default(cuid())
  promptName    String
  promptVersion String
  model         String
  inputHash     String
  /// Input after PII redaction — never raw SSNs or contact details.
  inputRedacted Json
  output        Json?
  status        AiRunStatus
  error         String?
  inputTokens   Int          @default(0)
  outputTokens  Int          @default(0)
  /// Cost in millionths of a US dollar.
  costMicros    Int          @default(0)
  caseId        String?
  case          Case?        @relation(fields: [caseId], references: [id])
  entityType    String?
  entityId      String?
  acceptance    AiAcceptance @default(PENDING)
  decidedById   String?
  decidedAt     DateTime?
  createdAt     DateTime     @default(now())

  @@index([caseId])
  @@index([promptName, promptVersion])
  @@map("ai_runs")
}

model DoNotContact {
  id             String   @id @default(cuid())
  normalizedName String?
  emailHash      String?
  addressHash    String?
  reason         String
  createdById    String?
  createdAt      DateTime @default(now())

  @@index([emailHash])
  @@index([addressHash])
  @@index([normalizedName])
  @@map("do_not_contact")
}

model AppSetting {
  key         String   @id
  value       Json
  updatedById String?
  updatedAt   DateTime @updatedAt

  @@map("app_settings")
}

/// In-app notifications for operators (e.g. a case unlocked from the waiting period).
model Notification {
  id        String           @id @default(cuid())
  userId    String
  kind      NotificationKind
  title     String
  body      String?
  caseId    String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, readAt])
  @@map("notifications")
}
