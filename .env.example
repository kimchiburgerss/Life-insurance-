# Copy to .env and fill in. Never commit .env.

# ── Database ──────────────────────────────────────────────────────────────────
# Local: `docker compose up -d db` gives you this exact URL.
DATABASE_URL="postgresql://heir:heir@localhost:5432/heirfinder?schema=public"
# Optional: integration tests default to "<DATABASE_URL database>_test".
# DATABASE_URL_TEST="postgresql://heir:heir@localhost:5432/heirfinder_test?schema=public"

# ── Auth (Better Auth) ────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
# The public URL of the app (used for cookies, CSRF origin checks, TOTP issuer).
BETTER_AUTH_URL="http://localhost:3000"
# Sign-in / 2FA attempts allowed per IP per minute (default 5). Only raise for tests.
# AUTH_ATTEMPTS_PER_MINUTE="5"

# ── PII encryption (AES-256-GCM) ──────────────────────────────────────────────
# Two DIFFERENT 32-byte keys. Generate each with: openssl rand -base64 32
# Losing PII_ENCRYPTION_KEY makes stored heir contact details unreadable — back it up
# in your password manager, separately from database backups.
PII_ENCRYPTION_KEY=""
PII_HMAC_KEY=""

# ── Imports & background jobs ─────────────────────────────────────────────────
# Largest upload accepted, in MB (default 50).
# IMPORT_MAX_MB="50"
# The background worker (imports, nightly re-scoring) runs inside the web server.
# If you run more than one web instance, set RUN_JOBS="false" on all but one.
# RUN_JOBS="true"

# ── Third-party integrations ──────────────────────────────────────────────────
# "true" (default) = every adapter (mail, email, e-sign, payments, data vendors,
# AI) uses its mock, so the whole app runs with no paid accounts.
MOCK_MODE="true"

# Added in later phases (leave blank until then):
# ANTHROPIC_API_KEY=""        # Phase 3 — AI research assistant
# LOB_API_KEY=""              # Phase 4 — physical mail
# POSTMARK_SERVER_TOKEN=""    # Phase 4 — email
# DROPBOX_SIGN_API_KEY=""     # Phase 5 — e-signature
# STRIPE_SECRET_KEY=""        # Phase 6 — invoicing
