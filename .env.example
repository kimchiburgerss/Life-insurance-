# Copy to .env and fill in. Never commit .env.

# ── Database ──────────────────────────────────────────────────────────────────
# Local: `docker compose up -d db` gives you this exact URL.
DATABASE_URL="postgresql://heir:heir@localhost:5432/heirfinder?schema=public"
# Optional: integration tests default to "<DATABASE_URL database>_test".
# DATABASE_URL_TEST="postgresql://heir:heir@localhost:5432/heirfinder_test?schema=public"

# ── Auth (Better Auth) ────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
# The public URL of the app (used for cookies, CSRF origin checks, TOTP issuer).
BETTER_AUTH_URL="http://localhost:3000"
# Sign-in / 2FA attempts allowed per IP per minute (default 5). Only raise for tests.
# AUTH_ATTEMPTS_PER_MINUTE="5"

# ── PII encryption (AES-256-GCM) ──────────────────────────────────────────────
# Two DIFFERENT 32-byte keys. Generate each with: openssl rand -base64 32
# Losing PII_ENCRYPTION_KEY makes stored heir contact details unreadable — back it up
# in your password manager, separately from database backups.
PII_ENCRYPTION_KEY=""
PII_HMAC_KEY=""
# Key rotation (OPERATIONS.md → Keys): version of PII_ENCRYPTION_KEY (1–9, default 1),
# and older keys still needed to read data until `npm run keys:rotate` has finished.
# PII_KEY_VERSION="1"
# PII_PREVIOUS_KEYS="1=<old base64 key>"

# ── Data retention (OPERATIONS.md → Data retention) ───────────────────────────
# Days after a case closes. Change only with counsel's advice (minimum 30).
# RETENTION_LOST_CASE_DAYS="180"      # contact details, messages, documents on lost cases
# RETENTION_WON_DOCUMENT_DAYS="730"   # uploaded documents and claim packets on won cases
# RETENTION_RECORD_DAYS="2557"        # everything incl. agreements (7 years)

# ── Imports & background jobs ─────────────────────────────────────────────────
# Largest upload accepted, in MB (default 50).
# IMPORT_MAX_MB="50"
# The background worker (imports, nightly re-scoring) runs inside the web server.
# If you run more than one web instance, set RUN_JOBS="false" on all but one.
# RUN_JOBS="true"

# ── Third-party integrations ──────────────────────────────────────────────────
# "true" (default) = every adapter (mail, email, e-sign, payments, data vendors,
# AI) uses its mock, so the whole app runs with no paid accounts.
MOCK_MODE="true"

# ── AI (Claude) ───────────────────────────────────────────────────────────────
# Used only when MOCK_MODE="false". Without it (or in mock mode) a deterministic
# local stand-in produces suggestions so the app still works.
# ANTHROPIC_API_KEY=""
# Model for every AI task. Default claude-opus-5-5; change only if you decide to.
# AI_MODEL="claude-opus-5-5"

# ── People-search vendor ──────────────────────────────────────────────────────
# The permissible purpose (GLBA/DPPA) from your vendor contract, recorded with every lookup.
# PEOPLE_SEARCH_PERMISSIBLE_PURPOSE=""

# ── Outreach (Phase 4) ────────────────────────────────────────────────────────
# Public address of the app, printed in opt-out links in letters and emails
# (defaults to BETTER_AUTH_URL). Must be reachable by heirs without logging in.
# PUBLIC_APP_URL="https://app.example.com"
#
# Physical mail — Lob (https://dashboard.lob.com). Used only when MOCK_MODE="false".
# Start with a test_ key (nothing is printed); switch to live_ when ready.
# LOB_API_KEY=""
# Secret of your Lob webhook (Lob dashboard → Webhooks). Endpoint: <PUBLIC_APP_URL>/api/webhooks/lob
# LOB_WEBHOOK_SECRET=""
#
# Email — sent from YOUR business mailbox over SMTP (Google Workspace, Microsoft 365,
# or your host). Transactional services such as Postmark/SendGrid/Resend forbid
# unsolicited outreach, so this app does not use them. Use an app password, not
# your login password. Used only when MOCK_MODE="false".
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_SECURE="false"          # "true" for port 465
# SMTP_USER="you@yourbusiness.com"
# SMTP_PASS=""

# ── Agreements / e-signature (Phase 5) ────────────────────────────────────────
# Dropbox Sign API key (https://app.hellosign.com/home/myAccount#api). Used only when
# MOCK_MODE="false". Without it, agreements can still be approved for paper signature.
# Set the account callback URL to <PUBLIC_APP_URL>/api/webhooks/esign.
# DROPBOX_SIGN_API_KEY=""
# "true" (default) sends watermarked, NOT legally binding test requests. Set "false" only
# when your attorney-approved agreement is switched on in Settings.
# DROPBOX_SIGN_TEST_MODE="true"

# ── Fee invoices (Phase 6) ────────────────────────────────────────────────────
# Stripe secret key (Dashboard → Developers → API keys). Used only when MOCK_MODE="false".
# Prefer a restricted key with write access to Customers, Invoices and Invoice items only.
# Start with a test key (sk_test_… / rk_test_…). Without a key, invoices can still be approved
# and sent manually (you mail or email the invoice yourself and mark it paid).
# STRIPE_SECRET_KEY=""
# Signing secret of your Stripe webhook endpoint <PUBLIC_APP_URL>/api/webhooks/stripe
# (events: invoice.paid, invoice.voided, invoice.marked_uncollectible, invoice.payment_failed).
# STRIPE_WEBHOOK_SECRET=""
#
# Document-review AI uses the same ANTHROPIC_API_KEY as the rest of the app (above).

# ── Tests ─────────────────────────────────────────────────────────────────────
# Integration tests use DATABASE_URL_TEST (default: DATABASE_URL + "_test"); end-to-end
# tests rebuild DATABASE_URL_E2E (default: DATABASE_URL + "_e2e") on every run and serve
# the app on E2E_PORT (default 3100). Both refuse databases without those suffixes.
# DATABASE_URL_TEST=""
# DATABASE_URL_E2E=""
# E2E_PORT="3100"
