{
  "name": "nevada-heir-finder",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test",
    "evals": "tsx --conditions=react-server scripts/run-evals.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset --force && prisma db seed",
    "demo": "tsx scripts/demo.ts",
    "demo:totp": "tsx scripts/demo-totp.ts",
    "user:create": "tsx --conditions=react-server scripts/create-user.ts",
    "postinstall": "prisma generate",
    "cases:rescore": "tsx --conditions=react-server scripts/rescore.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.14.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "better-auth": "1.7.28",
    "marked": "18.3.0",
    "next": "16.4.6",
    "nodemailer": "10.6.1",
    "papaparse": "5.7.1",
    "pg": "8.23.1",
    "pg-boss": "12.40.0",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "read-excel-file": "9.3.20",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@faker-js/faker": "10.6.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "22.20.7",
    "@types/nodemailer": "8.0.2",
    "@types/papaparse": "5.5.2",
    "@types/pg": "8.23.1",
    "@types/qrcode": "1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "5.1.2",
    "dotenv": "18.0.10",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "prisma": "7.10.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "5.1.2"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "effect": "3.22.5"
  }
}
